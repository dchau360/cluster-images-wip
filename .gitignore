# ---------------------------------------------------------------------------
# Host-specific configuration. Never tracked.
# ---------------------------------------------------------------------------
lab/local.env
lab/local.env.*
!lab/local.env.example

# ---------------------------------------------------------------------------
# Built image artefacts. Never tracked. These are outputs, and large.
# ---------------------------------------------------------------------------
build/
out/
cache/
*.tar
*.tar.gz
*.tar.zst
*.oci
*.sif
*.squashfs
*.img
*.qcow2
*.iso
*.raw
*.cpio
*.cpio.gz
*.cpio.zst
*.initramfs
*.initrd
vmlinuz*
initramfs*
initrd*
*.ko
*.efi

# Warewulf chroots and container stores
chroots/
containers/
provision/

# TFTP / PXE trees, in case a build ever writes one here
tftpboot/
tftproot/

# ---------------------------------------------------------------------------
# Secrets. These come from Warewulf per-node overlays at boot, never here.
# ---------------------------------------------------------------------------
*.key
*.pem
*.crt
*.p12
*.jks
id_rsa*
id_ed25519*
ssh_host_*
munge.key
*.vault
.vault-pass*
overlays/runtime/**/*.generated

# ---------------------------------------------------------------------------
# Ansible, logs, timings, editors
# ---------------------------------------------------------------------------
*.retry
.ansible/
*.log
*.pid
timings/
*.ndjson
.vscode/
.idea/
*.swp
*~
.DS_Store
__pycache__/
*.pyc
.venv/
venv/

# ---------------------------------------------------------------------------
# Must be tracked. Keep this LAST.
# ---------------------------------------------------------------------------
#
# lab/host-specific.vars holds variable NAMES only, never values, and it is
# the list the hygiene gate trusts to decide what counts as a host value.
#
# This negation lives at the end of the file on purpose. .gitignore is
# last-match-wins, so a negation placed above a broad glob loses to it — the
# `*.vars` rule in the lab-state section swallowed this file when the negation
# sat at the top, and the gate's "manifest is present but untracked" check is
# what caught it. At the end, no later rule can override it.
!lab/host-specific.vars
