# cluster-images-wip — host-specific configuration, EXAMPLE
#
# Copy to lab/local.env on the lab host and fill in. lab/local.env is
# .gitignored and CI fails if any of its values appears in a tracked file.
#
#   cp lab/local.env.example lab/local.env && $EDITOR lab/local.env
#
# Rules for this file:
#   * Every host-specific variable must be NAMED and DOCUMENTED here.
#   * Values here must be blank, synthetic, or lab-internal. Never real.
#
# The `# host-specific` tag is load-bearing, not decoration. It must match the
# list of names in lab/host-specific.vars, and the gate reports any
# disagreement. For every variable on that list: it may not be assigned a value
# here, and its value from local.env is searched for in every tracked file with
# no exemption of any kind.
#
# The list, not the tag, is what the gate trusts. Typing a value over a
# commented declaration deletes the tag in the same edit, so a gate reading
# only tags would fall silent on exactly that mistake.
#
# Leave a listed variable blank, or comment it out when the code has a sane
# fallback. Do not fill one in here "just as a default" — this file is sourced
# before local.env with `set -a`, so a value here is not a default at all. It
# overrides the code's own fallback, and it is the value everyone who clones
# the repository gets.

# ---------------------------------------------------------------------------
# 1. Lab host identity  —  BLANK HERE. NEVER COMMIT A REAL VALUE.
# ---------------------------------------------------------------------------

# SSH target for the Windows lab host, as user@host. Used only by the
# operator's workstation, never by code that runs on the lab host itself.
LAB_HOST_SSH=          # host-specific

# Name of the WSL2 distribution that runs the lab. Not host-specific: this is
# the stock name of an Ubuntu WSL image and it is read by `wsl -d`, which needs
# a real name rather than a fallback.
LAB_WSL_DISTRO=Ubuntu

# Login name inside WSL that owns the build output.
#
# DELIBERATELY UNASSIGNED. The code reads ${LAB_WSL_USER:-${USER:-$(id -un)}},
# so leaving this unset makes the build run as whoever invokes it — the lab
# host, a CI runner, anyone's clone. Set it in lab/local.env only when the
# account that must OWN the build output differs from the account running make.
#
# This shipped `ubuntu` once, on the reasoning that `ubuntu` is the stock login
# in an Ubuntu WSL image and so identifies nothing. The disclosure argument was
# fine; the mechanism was not. This file is sourced with `set -a`, so assigning
# anything here makes the fallback dead code and hard-codes one machine's
# account for every machine. CI caught it on the first push: `chown: invalid
# user: 'ubuntu'` on a runner whose account is `runner`.
#LAB_WSL_USER=          # host-specific

# ---------------------------------------------------------------------------
# 2. Build
# ---------------------------------------------------------------------------

# Container engine used to build images. docker or podman.
IMAGE_ENGINE=docker

# Base image every node image starts from. Pinned on purpose: an unpinned
# base makes the 1-to-N curve unreproducible.
IMAGE_BASE=docker.io/rockylinux/rockylinux:9

# Registry prefix for built images. Local only by default: nothing from
# this lab is pushed anywhere public.
IMAGE_PREFIX=cluster-lab

# Build output. Outside the repository, never in git.
IMAGE_BUILD_DIR=/var/lib/cluster-lab/images

# Shared state root, same as the platform repository uses.
LAB_STATE_DIR=/var/lib/cluster-lab

# ---------------------------------------------------------------------------
# 3. Warewulf
# ---------------------------------------------------------------------------

# Where built images are imported for serving.
WAREWULF_ROOT=/var/lib/warewulf

# Node profile that imported images attach to.
WAREWULF_PROFILE=default

# ---------------------------------------------------------------------------
# 4. Timeouts, seconds
# ---------------------------------------------------------------------------

IMAGE_BUILD_TIMEOUT=1800
